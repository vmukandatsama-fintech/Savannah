{% extends "base.html" %}
{% load humanize %}

{% block content %}
<div class="card">
    <a href="{% url 'collection_history' %}">← Back to Collection History</a>
</div>

<div class="card">
    <h2 style="margin-top:0;">Collection Detail</h2>

    <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:10px;">
        <div><strong>Collection Number:</strong> {{ header.CollectionNumber }}</div>
        <div><strong>Collection Date:</strong> {{ header.CollectionDate|date:"d-m-Y H:i" }}</div>

        <div><strong>Request Number:</strong> {{ header.RequestNumber }}</div>
        <div><strong>Status:</strong> {{ header.StatusName }}</div>

        <div><strong>Department:</strong> {{ header.DepartmentName }}</div>
        <div><strong>Disbursed By:</strong> {{ header.DisbursedByName|default:header.DisbursedBy }}</div>

        <div><strong>Farmer:</strong> {{ header.FarmerName|default:"-" }}</div>
        <div><strong>Collector:</strong> {{ header.CollectorName|default:"-" }}</div>

        <div><strong>National ID:</strong> {{ header.CollectorNationalID|default:"-" }}</div>
        <div><strong>Truck:</strong> {{ header.TruckRegistration|default:"-" }}</div>

        <div><strong>Trailer:</strong> {{ header.TrailerRegistration|default:"-" }}</div>
    </div>
</div>

<div class="card">
    <h3 style="margin-top:0;">Voucher</h3>

    <p><strong>Status:</strong> {{ header.VoucherStatus|default:"-" }}</p>

    <p>
        <strong>Path:</strong>
        {% if header.VoucherPath %}
            {{ header.VoucherPath }}
        {% else %}
            -
        {% endif %}
    </p>

    <p>
        <strong>Error:</strong>
        {% if header.VoucherError %}
            {{ header.VoucherError }}
        {% else %}
            -
        {% endif %}
    </p>

    <div style="margin-top:15px; display:flex; gap:10px; flex-wrap:wrap;">
        {% if header.VoucherPath %}
        <a href="{% url 'open_collection_voucher' header.CollectionNumber %}" target="_blank">
            <button type="button" class="btn btn-light">Open Voucher</button>
        </a>

        <a href="{% url 'download_collection_voucher' header.CollectionNumber %}">
            <button type="button" class="btn btn-light">Download Voucher</button>
        </a>
        {% endif %}

        <a href="{% url 'regenerate_collection_voucher' header.CollectionNumber %}">
            <button type="button" class="btn">Regenerate Voucher</button>
        </a>
    </div>
</div>

<div class="card">
    <h3 style="margin-top:0;">Collection Items</h3>

    <div style="overflow-x:auto;">
        <table>
            <thead>
                <tr>
                    <th>Line</th>
                    <th>Item Code</th>
                    <th>Item Name</th>
                    <th>UOM</th>
                    <th class="numeric">Requested</th>
                    <th class="numeric">This Issue</th>
                    <th class="numeric">Total Issued To Date</th>
                    <th class="numeric">Remaining After Issue</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                {% for line in lines %}
                <tr>
                    <td>{{ line.LineNumber }}</td>
                    <td>{{ line.ItemCode }}</td>
                    <td>{{ line.ItemName }}</td>
                    <td>{{ line.UOM }}</td>
                    <td class="numeric">
                        {% if line.QuantityRequested is not None %}
                            {{ line.QuantityRequested|floatformat:0|intcomma }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td class="numeric">
                        {% if line.ThisIssueQty is not None %}
                            {{ line.ThisIssueQty|floatformat:0|intcomma }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td class="numeric">
                        {% if line.TotalIssuedToDate is not None %}
                            {{ line.TotalIssuedToDate|floatformat:0|intcomma }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td class="numeric">
                        {% if line.RemainingAfterIssue is not None %}
                            {{ line.RemainingAfterIssue|floatformat:0|intcomma }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td>{{ line.CreatedDate|date:"d-m-Y H:i" }}</td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="9" style="padding:20px; text-align:center;" class="muted">
                        No collection lines found.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}