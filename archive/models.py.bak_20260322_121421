from django.db import models


class Users(models.Model):
    userid = models.AutoField(db_column="UserID")
    name = models.CharField(
        db_column="Name",
        max_length=255,
        db_collation="Latin1_General_CI_AS",
    )
    email = models.CharField(
        db_column="Email",
        primary_key=True,
        max_length=255,
        db_collation="Latin1_General_CI_AS",
    )
    isactive = models.BooleanField(db_column="IsActive", blank=True, null=True)
    passwordhash = models.CharField(
        db_column="PasswordHash",
        max_length=255,
        db_collation="Latin1_General_CI_AS",
        blank=True,
        null=True,
    )
    salt = models.CharField(
        db_column="Salt",
        max_length=255,
        db_collation="Latin1_General_CI_AS",
        blank=True,
        null=True,
    )

    class Meta:
        managed = False
        db_table = "Users"
        verbose_name = "SQL User"
        verbose_name_plural = "SQL Users"

    def __str__(self):
        return self.name or self.email


class Roles(models.Model):
    roleid = models.AutoField(db_column="RoleID", primary_key=True)
    name = models.CharField(
        db_column="Name",
        unique=True,
        max_length=50,
        db_collation="Latin1_General_CI_AS",
    )
    description = models.CharField(
        db_column="Description",
        max_length=255,
        db_collation="Latin1_General_CI_AS",
        blank=True,
        null=True,
    )

    class Meta:
        managed = False
        db_table = "Roles"
        verbose_name = "Role"
        verbose_name_plural = "Roles"

    def __str__(self):
        return self.name


class UserDepartmentRoles(models.Model):
    mapid = models.AutoField(db_column="MapID", primary_key=True)
    useremail = models.OneToOneField(
        Users,
        models.DO_NOTHING,
        db_column="UserEmail",
        blank=True,
        null=True,
        related_name="department_role",
    )
    departmentcode = models.ForeignKey(
        "Departments",
        models.DO_NOTHING,
        db_column="DepartmentCode",
        blank=True,
        null=True,
    )
    roleid = models.ForeignKey(
        Roles,
        models.DO_NOTHING,
        db_column="RoleID",
        blank=True,
        null=True,
    )
    departmentname = models.CharField(
        db_column="DepartmentName",
        max_length=255,
        db_collation="Latin1_General_CI_AS",
        blank=True,
        null=True,
    )
    rolename = models.CharField(
        db_column="RoleName",
        max_length=255,
        db_collation="Latin1_General_CI_AS",
        blank=True,
        null=True,
    )

    class Meta:
        managed = False
        db_table = "UserDepartmentRoles"
        verbose_name = "User Department Role"
        verbose_name_plural = "User Department Roles"

    def __str__(self):
        user = self.useremail_id or "Unknown User"
        dept = self.departmentcode_id or self.departmentname or "No Department"
        role = self.roleid_id or self.rolename or "No Role"
        return f"{user} | {dept} | {role}"
